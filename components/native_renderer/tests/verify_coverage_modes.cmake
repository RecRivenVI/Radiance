foreach(PACK IN ITEMS vanilla-pt advanced)
    file(READ "${MCVR_SOURCE_DIR}/src/shader/world/ray_tracing/internal/${PACK}/configs.json" CONFIG)
    string(JSON COUNT LENGTH "${CONFIG}" attributes)
    math(EXPR LAST "${COUNT} - 1")
    set(FOUND FALSE)
    set(KEY "render_pipeline.module.ray_tracing.attribute.coverage_mode")
    foreach(INDEX RANGE 0 ${LAST})
        string(JSON NAME GET "${CONFIG}" attributes ${INDEX} name)
        if(NAME STREQUAL KEY)
            if(FOUND)
                message(FATAL_ERROR "Duplicate coverage setting in ${PACK}")
            endif()
            set(FOUND TRUE)
            string(JSON DEFAULT GET "${CONFIG}" attributes ${INDEX} default_value)
            string(JSON TYPE GET "${CONFIG}" attributes ${INDEX} type)
            string(JSON DEFINE GET "${CONFIG}" attributes ${INDEX} define RADIANCE_COVERAGE_MODE)
            if(NOT DEFAULT STREQUAL "${KEY}.stochastic" OR
               NOT TYPE STREQUAL "enum:${KEY}.stochastic-${KEY}.blend" OR NOT DEFINE STREQUAL "X")
                message(FATAL_ERROR "Coverage enum/default/preprocessor mapping changed in ${PACK}")
            endif()
        endif()
    endforeach()
    if(NOT FOUND)
        message(FATAL_ERROR "Missing coverage setting in ${PACK}")
    endif()
    string(JSON COUNT LENGTH "${CONFIG}" passes)
    math(EXPR LAST "${COUNT} - 1")
    foreach(INDEX RANGE 0 ${LAST})
        string(JSON CAPTURE ERROR_VARIABLE MISSING GET "${CONFIG}" passes ${INDEX}
            hit_groups world_no_reflect definitions RADIANCE_COVERAGE_CAPTURE)
        if(NOT MISSING AND NOT CAPTURE STREQUAL "0")
            message(FATAL_ERROR "Unlit alpha capture has no compositing continuation: ${PACK}/${INDEX}")
        endif()
        string(JSON GROUP ERROR_VARIABLE ABSENT GET "${CONFIG}" passes ${INDEX} hit_groups world_no_reflect shaders rchit)
        if(NOT ABSENT AND GROUP MATCHES "world_no_reflect[.]rchit$" AND MISSING)
            message(FATAL_ERROR "Unlit hit group must retain its original estimator: ${PACK}/${INDEX}")
        endif()
    endforeach()
endforeach()
message(STATUS "Coverage defaults, enum mapping and unlit scope in both actual pack configurations passed")

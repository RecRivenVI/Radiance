#version 460
#extension GL_EXT_ray_query : require
#extension GL_GOOGLE_include_directive : require
#include "util/coverage_blend.glsl"
#include "util/ray_origin.glsl"
layout(local_size_x = 1) in;
layout(set = 0, binding = 0) uniform accelerationStructureEXT scene;
layout(set = 0, binding = 1, std430) buffer Results { uint result[]; };
layout(set = 0, binding = 2, std430) readonly buffer Cases { uvec4 cases[]; };
bool closest(vec3 origin, vec3 direction, uint mask, out float distance, out uint owner) {
    rayQueryEXT ray;
    rayQueryInitializeEXT(ray, scene, 0u, mask, origin, 0.0, direction, 4.0);
    while (rayQueryProceedEXT(ray)) rayQueryConfirmIntersectionEXT(ray);
    if (rayQueryGetIntersectionTypeEXT(ray, true) != gl_RayQueryCommittedIntersectionTriangleEXT) return false;
    distance = rayQueryGetIntersectionTEXT(ray, true);
    owner = rayQueryGetIntersectionInstanceCustomIndexEXT(ray, true);
    return true;
}
void main() {
    uint i = gl_GlobalInvocationID.x, c = i / 4u, g = (i / 2u) % 2u, side = i % 2u;
    float mirror = cases[c].z == 0u ? 1.0 : -1.0;
    vec3 origin = vec3(mirror * ((cases[c].w & 0x40000000u) != 0u ? 0.0 : float(g) * 3.0),
                       float(c) * 4.0, side == 0u ? 2.0 : -2.0);
    vec3 direction = vec3(0.0, 0.0, side == 0u ? -1.0 : 1.0);
    float distance;
    uint owner;
    vec3 color = vec3(0.0);
    float remaining = 1.0;
    if (!closest(origin, direction, 1u, distance, owner)) { result[i] = 0xffffffffu; return; }
    accumulateCoverage(color, remaining, vec3(1.0, 0.0, 0.0), float(c % 10u) / 9.0);
    origin = offsetQueryOrigin(origin + direction * distance, direction, direction);
    if (closest(origin, direction, 1u | (side == 0u ? 2u : 4u), distance, owner))
        accumulateCoverage(color, remaining, owner == 1u ? vec3(0.0, 0.0, 1.0) : vec3(0.0, 1.0, 0.0), 1.0);
    result[i] = packUnorm4x8(vec4(color, remaining));
}

#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#include "util/height_map.glsl"
#include "util/surface_geometry.glsl"
vec3 legacyApplyNormalMapToBasis(vec3 matNormal,
                           vec3 tangent,
                           vec3 bitangent,
                           vec3 geometricNormal,
                           vec3 viewDir) {
    if (any(isnan(matNormal))) { return geometricNormal; }

    vec3 correctedLocalNormal = matNormal;
    correctedLocalNormal.y = -correctedLocalNormal.y;

    vec3 normal = normalizeF(tangent * correctedLocalNormal.x + bitangent * correctedLocalNormal.y +
                                 geometricNormal * correctedLocalNormal.z,
                             geometricNormal);
    float NdotV = dot(normal, viewDir);
    if (NdotV >= 0.99999) { return normal; }

    vec3 edgeNormal = normal - viewDir * NdotV;
    float edgeNormalLen2 = dot(edgeNormal, edgeNormal);
    if (edgeNormalLen2 <= 1e-10) { return geometricNormal; }

    float weight = 1.0 - NdotV;
    weight = sin(min(weight, PI * 0.5));
    weight = clamp(min(max(NdotV, dot(viewDir, geometricNormal)), 1.0 - weight), 0.0, 1.0);

    float tangentWeight2 = max(1.0 - weight * weight, 0.0);
    if (tangentWeight2 <= 1e-10) { return geometricNormal; }

    return viewDir * weight + edgeNormal * inversesqrt(edgeNormalLen2 / tangentWeight2);
}
vec3 legacyBasePlaneWorldPosAtUv(vec2 uv,
                           vec2 referenceUv,
                           vec3 referenceWorldPos,
                           vec3 dPduWorld,
                           vec3 dPdvWorld) {
    vec2 uvOffset = uv - referenceUv;
    return referenceWorldPos + dPduWorld * uvOffset.x + dPdvWorld * uvOffset.y;
}
#include "util/diagram_math.glsl"
#include "util/surface_overlay.glsl"
#include "util/source_draw_colour.glsl"
#include "common/final_position.hpp"
#include "util/primitive_history.glsl"
#include "util/material_decode.glsl"
#include "util/celestial_math.glsl"
#include "util/priority_coverage.glsl"
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) buffer Output { vec4 values[]; } result;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= 257u * 32u * 32u) return;
    float coverage = float(i / 1024u) / 256.0;
    vec2 pixel = vec2(i % 32u, (i / 32u) % 32u) + 0.5;
    float alpha = ditherMask(coverage, pixel);
    vec3 albedo = vec3(0.2, 0.6, 0.9), red = vec3(1, 0, 0);
    vec3 stress = applySurfaceOverlay(albedo, red, coverage);
    vec3 hurt = applySurfaceOverlay(albedo, red, 1.0 - (1.0 - coverage));
    vec2 p = diagramLogicalPixel(vec2(20.5, 40.5), vec4(20, 40, 544, 460), vec2(272, 230));
    float priorityError = abs(resolvePriorityAlpha(coverage, ALPHA_MODE_CUTOUT_LOW) - (coverage >= .1 ? 1.0 : 0.0));
    priorityError = max(priorityError, abs(resolvePriorityAlpha(.1, ALPHA_MODE_CUTOUT_LOW) - 1.0));
    priorityError = max(priorityError, abs(resolvePriorityAlpha(coverage, POST_TEXT_MODE_RGBA_SEE_THROUGH) - coverage));
    for (uint k = 0u; k < 3u; ++k) {
        uint mode = k == 0u ? ALPHA_MODE_CUTOUT : (k == 1u ? ALPHA_MODE_CUTOUT_LOW : 3u);
        float threshold = k == 0u ? 0.5 : (k == 1u ? 0.1 : 0.01);
        priorityError = max(priorityError, abs(resolveSurfaceAlpha(coverage, mode) - (coverage >= threshold ? 1.0 : 0.0)));
        priorityError = max(priorityError, abs(resolvePriorityAlpha(threshold, mode) - 1.0));
        priorityError = max(priorityError, abs(resolveSurfaceAlpha(threshold - 0.0001, mode)));
    }
    // Source shader counterexamples: cutout before vertex/global vs after each modulation.
    priorityError = max(priorityError, abs(resolveSourceAlpha(.2, .2, .2, 0u, 2u) - 1.0));
    priorityError = max(priorityError, abs(resolveSourceAlpha(.09, 1.0, 1.0, 0u, 2u)));
    priorityError = max(priorityError, abs(resolveSourceAlpha(.2, .2, .2, 10u, 5u)));
    priorityError = max(priorityError, abs(resolveSourceAlpha(.2, 1.0, .2, 17u, 7u) - .04));
    priorityError = max(priorityError, abs(resolveSourceAlpha(.2, 1.0, .2, 14u, 5u)));
    vec4 g = vec4(.2, .3, .4, .5);
    vec3 expectedStress = mix(albedo * g.rgb, red, coverage);
    vec3 actualStress = applySurfaceMaterialColor(albedo, vec4(red, coverage), true, false, vec4(0), g);
    priorityError = max(priorityError, max(max(abs(actualStress-expectedStress).r, abs(actualStress-expectedStress).g), abs(actualStress-expectedStress).b));
    uint geometryIndex;
    if (!decodeSurfaceGeometryTag(1.0, 5u, geometryIndex) || geometryIndex != 0u) priorityError = 1.0;
    if (!decodeSurfaceGeometryTag(5.0, 5u, geometryIndex) || geometryIndex != 4u) priorityError = 1.0;
    if (!decodeSurfaceGeometryTag(11671106.0, 11671106u, geometryIndex) || geometryIndex != 11671105u) priorityError = 1.0;
    if (decodeSurfaceGeometryTag(0.0, 5u, geometryIndex) || decodeSurfaceGeometryTag(6.0, 5u, geometryIndex)
        || decodeSurfaceGeometryTag(1.5, 5u, geometryIndex) || decodeSurfaceGeometryTag(-1.0, 5u, geometryIndex)
        || decodeSurfaceGeometryTag(uintBitsToFloat(0x7FC00000u), 5u, geometryIndex)
        || decodeSurfaceGeometryTag(uintBitsToFloat(0x7F800000u), 5u, geometryIndex)) priorityError = 1.0;
    if (resolveDrawColour(1u, g) != vec4(1.0) || resolveDrawColour(8192u, g) != g) priorityError = 1.0;
    if (resolveEyeColour(2u, g) != vec4(1.0) || resolveEyeColour(APPEARANCE_EYE_COLOUR, g) != g) priorityError = 1.0;
    vec3 eyeExpected=vec3(.2,.4,.6)*g.rgb*.5;
    vec3 eyeActual=resolveEyeRadiance(vec4(.2,.4,.6,.5),g);
    priorityError=max(priorityError,length(eyeActual-eyeExpected));
    priorityError=max(priorityError,length(eyeActual-resolveEyeRadiance(vec4(.2,.4,.6,.5),vec4(g.rgb,1.0))));
    for (uint face = 0u; face < 4u; ++face) {
        uint packedEye = 42u | ((face & 1u) != 0u ? EYE_CULL_BACK_BIT : 0u)
            | ((face & 2u) != 0u ? EYE_CULL_FRONT_BIT : 0u);
        bool hardwareFront = (i & 1u) != 0u, flip = (i & 2u) != 0u;
        bool directImage = (i & 4u) != 0u;
        bool sourceFront = hardwareFront != flip;
        bool hidden = sourceFront ? (face & 2u) != 0u : (face & 1u) != 0u;
        uint actualEye = eyeOverlayTextureForQuery(packedEye,
            flip ? FACE_HARDWARE_FRONT_FLIP_BIT : 0u, hardwareFront, directImage);
        if (actualEye != (directImage && hidden ? 0u : 42u)) priorityError = 1.0;
        // Transport still reaches the coloured emitter from either side, including a source-hidden side.
        uint transportEye = eyeOverlayTextureForQuery(packedEye,0u,hardwareFront,false);
        vec3 receiverRadiance = vec3(.5) * resolveEyeRadiance(vec4(.8,.1,.2,1), vec4(1));
        if (transportEye != 42u || receiverRadiance.r <= 0.0 || receiverRadiance.g <= 0.0) priorityError=1.0;
    }
    vec3 sourcePosition=vec3(.2,-.3,.9),sourceNormal=vec3(-2,3,-7);
    priorityError=max(priorityError,length(finalPosition(sourcePosition,sourceNormal,true)-(sourcePosition+.00001*normalize(sourceNormal))));
    priorityError=max(priorityError,length(finalPosition(sourcePosition,sourceNormal,false)-sourcePosition));
    if(!samePrimitiveHistory(uvec3(0,1,2),0u,uvec3(0,1,2),0u)
        || samePrimitiveHistory(uvec3(0,1,2),0u,uvec3(0,2,1),0u)
        || samePrimitiveHistory(uvec3(0,1,2),2u,uvec3(0,1,2),0u)
        || !samePrimitiveHistory(uvec3(0,1,2),1u,uvec3(0,1,2),0u)) priorityError=1.0;
    uint packed=i|((i%8u)<<PACKED_ALPHA_RULE_SHIFT);
    if(getAlphaMode(packed)!=((packed>>8u)&31u) || getCoordinate(packed)!=((packed>>13u)&15u)
        || hasColorLayer(packed)!=((packed&1u)!=0u) || hasTexture(packed)!=((packed&2u)!=0u)
        || hasOverlay(packed)!=((packed&4u)!=0u) || hasGlint(packed)!=((packed&8u)!=0u)
        || hasNorm(packed)!=((packed&16u)!=0u) || hasLight(packed)!=((packed&32u)!=0u)
        || hasColorLayerMix(packed)!=((packed&64u)!=0u)
        || getSourceAlphaRule(packed)!=(i%8u)) priorityError=1.0;
    if(celestialNormalize(vec3(0),vec3(0,1,0))!=vec3(0,1,0)) priorityError=1.0;
    vec3 southExpected=normalize(vec3(0,.984807753012208,.17364817766693033));
    priorityError=max(priorityError,length(celestialApplySouthOffset(vec3(0,1,0))-southExpected));
    priorityError=max(priorityError,length(celestialMoonFromSource(vec3(.3,.7,.9))+celestialSunFromSource(vec3(.3,.7,.9))));
    if (i < 64u) {
        float parity = (i & 1u) == 0u ? 1.0 : -1.0;
        vec3 tangent = vec3(parity * (1.0 + float(i % 3u)), 0, 0);
        vec3 bitangent = vec3(0, .7 + float(i % 5u), 0);
        vec3 geo = vec3(0,0,1), view = normalize(vec3(sin(float(i)),cos(float(i)),.2));
        vec3 map = vec3(.3, -.4, .8);
        if (i % 8u == 7u) map.x=uintBitsToFloat(0x7fc00000u);
        vec3 actual = applyNormalMapToBasis(map,tangent,bitangent,geo,view);
        vec3 expected = legacyApplyNormalMapToBasis(map,tangent,bitangent,geo,view);
        if (any(isnan(actual)) || any(isinf(actual))) priorityError=1.0;
        priorityError=max(priorityError,length(actual-expected));
        vec2 uv=vec2(float(i),-.5),referenceUv=vec2(.25,.75);
        priorityError=max(priorityError,length(basePlaneWorldPosAtUv(uv,referenceUv,geo,tangent,bitangent)
            -legacyBasePlaneWorldPosAtUv(uv,referenceUv,geo,tangent,bitangent)));
    }
    result.values[i] = vec4(alpha, stress.r, max(priorityError, max(max(abs(stress-hurt).r, abs(stress-hurt).g), abs(stress-hurt).b)), p.y);
}

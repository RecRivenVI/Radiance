#version 460
#extension GL_GOOGLE_include_directive : require
#include "common/shared.hpp"
#include "util/layered_coordinates.glsl"
layout(local_size_x=1) in;
layout(set=0,binding=0,std430) buffer Results {vec4 rows[];} result;
void main() {
    uint i=gl_GlobalInvocationID.x;
    // A double variable does not make unsuffixed GLSL literals double-precision inputs.
    double x=i<5?20000001.25lf:-20000001.25lf;
    double z=i<5?-29999997.75lf:29999997.75lf;
    dvec3 camera=dvec3(x+.125*double(i),80,z-.25*double(i));
    LayeredWorldMaterial material;
    material.origin=vec4(float(x),72,float(z),128);
    material.motion=vec4(0,0,float(x-double(float(x))),float(z-double(float(z))));
    material.uv=vec4(.04,.04,0,0);
    material.settings.w=128u;
    vec3 scene=layeredOriginScene(material,camera)+vec3(.25,-.5,.75);
    result.rows[i*8]=vec4(layeredMaskUv(material,scene,camera),0,1);
    result.rows[i*8+1]=vec4(layeredPlaneUv(material,scene,camera,0),0,1);
    result.rows[i*8+2]=vec4(layeredOriginScene(material,camera),1);
    // Negative control: a fractional local position vanishes after absolute-float reconstruction.
    vec2 oldMask=(vec3(camera+ dvec3(scene)).xz-material.origin.xz)/256.0+.5;
    result.rows[i*8+3]=vec4(oldMask,0,1);
    material.settings.w=0u;
    result.rows[i*8+4]=vec4(layeredPlaneUv(material,scene,camera,0),0,1);
}

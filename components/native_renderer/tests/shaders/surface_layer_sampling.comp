#version 460
#extension GL_GOOGLE_include_directive : require
#include "util/surface_layer_sampling.glsl"
#include "util/alpha_mode.glsl"
layout(local_size_x=1) in;
layout(set=0,binding=0,std430) buffer Results { vec4 rows[]; } result;
void main(){
 uint id=gl_GlobalInvocationID.x;
 float a=float(id)/9.0;
 vec4 sum=vec4(0);
 uint mismatch=0u;
 const uint samples=65536u;
 for(uint n=0u;n<samples;++n){
  vec3 origin=vec3(.2,.3,1),direction=vec3(0,0,-1);
  float u=surfaceLayerRandom(origin,direction,n,id,0u);
  float v=surfaceLayerRandom(origin,direction,n,id,0u);
  float alpha=resolveSourceAlpha(1.0,a,1.0,ALPHA_COVERAGE,SOURCE_ALPHA_POST_LOW);
  bool top=chooseSurfaceLayer(u,alpha);
  if(top!=chooseSurfaceLayer(v,alpha))++mismatch;
  // Red fullbright coating over blue ordinary substrate. Source-over includes
  // physical red emission with the same coverage; ordinary substrate stays unlit.
  sum+= top?vec4(1,0,0,1):vec4(0,0,1,0);
 }
 result.rows[id*8u]=sum/float(samples);
 result.rows[id*8u+1u]=vec4(float(mismatch),a,0,0);
 // Two half-coverage ordinary coats over opaque substrate: green .5, red .25, blue .25.
 vec3 order=vec3(0);
 for(uint n=0u;n<samples;++n){
  float u=surfaceLayerRandom(vec3(0),vec3(0,0,1),n,id,2u);
  if(chooseSurfaceLayer(u,.5))order.y+=1;
  else if(chooseSurfaceLayer(u,.5))order.x+=1;
  else order.z+=1;
 }
 result.rows[id*8u+2u]=vec4(order/float(samples),0);
}

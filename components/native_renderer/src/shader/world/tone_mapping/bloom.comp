#version 460
layout(local_size_x=8,local_size_y=8) in;
layout(set=0,binding=0) uniform sampler2D sourceImage;
layout(set=0,binding=1) uniform sampler2D fineImage;
layout(set=0,binding=2,rgba16f) uniform writeonly image2D destination;
layout(set=0,binding=3) readonly buffer Exposure { float value; float average; uint valid; uint padding; } exposure;
layout(push_constant) uniform Parameters { vec4 data; } pc;
vec3 bright(vec3 value) {
    float ev=pc.data.y>0.5?exposure.value:pc.data.z;
    if(isnan(ev)||isinf(ev)||ev<=0.0)ev=max(pc.data.z,1e-6);
    value=max(value,vec3(0.0))*ev*pc.data.w;
    float luminance=dot(value,vec3(0.2126,0.7152,0.0722));
    float knee=clamp(luminance-0.5,0.0,1.0);
    float weight=max(luminance-1.0,knee*knee*0.5)/max(luminance,1e-6);
    return value*weight;
}
void main() {
    ivec2 pixel=ivec2(gl_GlobalInvocationID.xy), size=imageSize(destination);
    if(any(greaterThanEqual(pixel,size)))return;
    vec2 uv=(vec2(pixel)+0.5)/vec2(size), stepSize=1.0/vec2(textureSize(sourceImage,0));
    vec3 colour=vec3(0.0);
    if(pc.data.x<1.5) {
        for(int y=-1;y<=1;y+=2)for(int x=-1;x<=1;x+=2) {
            vec3 sampleValue=texture(sourceImage,uv+vec2(x,y)*stepSize*0.5).rgb;
            colour+=pc.data.x>0.5?bright(sampleValue):sampleValue;
        }
        colour*=0.25;
    } else {
        for(int y=-1;y<=1;++y)for(int x=-1;x<=1;++x) {
            float weight=float((x==0?2:1)*(y==0?2:1));
            colour+=texture(sourceImage,uv+vec2(x,y)*stepSize).rgb*weight/16.0;
        }
        colour=mix(texture(fineImage,uv).rgb,colour,0.65);
    }
    imageStore(destination,pixel,vec4(clamp(colour,0.0,60000.0),0.0));
}

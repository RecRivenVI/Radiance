#version 460
#extension GL_GOOGLE_include_directive : require

#include "shader/world/nrd/nrd_glsl_compat.glsl"
#include "common/shared.hpp"
#include "shader/util/reconstruction_material.glsl"
#include "shader/util/reconstruction_guides.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform readonly image2D directRadianceImage;
layout(set = 0, binding = 1, rgba16f) uniform readonly image2D diffuseIndirectRadianceImage;
layout(set = 0, binding = 2, rgba16f) uniform readonly image2D specularIndirectRadianceImage;
layout(set = 0, binding = 3, rgba8) uniform readonly image2D diffuseAlbedoMetallicImage;
layout(set = 0, binding = 4, rgba8) uniform readonly image2D specularAlbedoImage;
layout(set = 0, binding = 5, rg16f) uniform readonly image2D motionVectorImage;
layout(set = 0, binding = 6, rgba16f) uniform readonly image2D normalRoughnessImage;
layout(set = 0, binding = 7, r16f) uniform readonly image2D linearDepthImage;
layout(set = 0, binding = 8, rgba16f) uniform readonly image2D clearRadianceImage;
layout(set = 0, binding = 9, r16f) uniform readonly image2D specularHitDepthImage;
layout(set = 0, binding = 10, rgba16f) uniform readonly image2D refractionRadianceImage;

layout(set = 0, binding = 11, rgba16f) uniform readonly image2D reflectionGuideImage;
layout(set = 0, binding = 12, rgba16f) uniform readonly image2D reflectionMotionDepthImage;
layout(set = 0, binding = 13, rgba16f) uniform readonly image2D transmissionGuideImage;
layout(set = 0, binding = 14, rgba16f) uniform readonly image2D transmissionMotionDepthImage;
layout(set = 0, binding = 15, rgba8) uniform readonly image2D reflectionMaterialFactorImage;
layout(set = 0, binding = 16, rgba8) uniform readonly image2D transmissionMaterialFactorImage;

layout(set = 1, binding = 0, rgba16f) uniform writeonly image2D nrdDiffuseRadianceImage;
layout(set = 1, binding = 1, rgba16f) uniform writeonly image2D nrdSpecularRadianceImage;
layout(set = 1, binding = 2, rg16f) uniform writeonly image2D nrdMotionVectorImage;
#if NRD_NORMAL_ENCODING == NRD_NORMAL_ENCODING_R10G10B10A2_UNORM
layout(set = 1, binding = 3, rgb10_a2) uniform writeonly image2D nrdNormalRoughnessImage;
#elif NRD_NORMAL_ENCODING == NRD_NORMAL_ENCODING_RGBA8_UNORM
layout(set = 1, binding = 3, rgba8) uniform writeonly image2D nrdNormalRoughnessImage;
#elif NRD_NORMAL_ENCODING == NRD_NORMAL_ENCODING_RGBA8_SNORM
layout(set = 1, binding = 3, rgba8_snorm) uniform writeonly image2D nrdNormalRoughnessImage;
#elif NRD_NORMAL_ENCODING == NRD_NORMAL_ENCODING_RGBA16_UNORM
layout(set = 1, binding = 3, rgba16) uniform writeonly image2D nrdNormalRoughnessImage;
#elif NRD_NORMAL_ENCODING == NRD_NORMAL_ENCODING_RGBA16_SNORM
layout(set = 1, binding = 3, rgba16_snorm) uniform writeonly image2D nrdNormalRoughnessImage;
#else
#error Unsupported NRD normal encoding
#endif
layout(set = 1, binding = 4, r16f) uniform writeonly image2D nrdLinearDepthImage;

layout(set = 2, binding = 0) uniform WorldUniform {
    WorldUBO worldUBO;
};

layout(push_constant) uniform HitDistanceParameters {
    vec4 value;
} hitDistance;
const float NRD_INF_DEPTH = 65504.0;

vec3 safeDiv(vec3 a, vec3 b) {
    return a / max(b, vec3(1e-3));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(directRadianceImage);
    if (pixel.x >= size.x || pixel.y >= size.y) return;

    bool transmissionLayer = hitDistance.value.w > 0.5;
    vec4 reflectionGuide = imageLoad(reflectionGuideImage, pixel);
    vec4 transmissionGuide = imageLoad(transmissionGuideImage, pixel);
    bool reflectionGuided = reconstructionGuideValid(reflectionGuide);
    bool transmissionGuided = reconstructionGuideValid(transmissionGuide);
    vec4 guideMotion = transmissionLayer ? imageLoad(transmissionMotionDepthImage, pixel) : imageLoad(reflectionMotionDepthImage, pixel);
    bool guided = transmissionLayer ? transmissionGuided : reflectionGuided;
    float linearDepth = transmissionLayer && !guided ? NRD_INF_DEPTH :
        guided ? guideMotion.z : imageLoad(linearDepthImage, pixel).r;
    bool invalidDepth = isnan(linearDepth) || isinf(linearDepth) || linearDepth >= NRD_INF_DEPTH * 0.9;
    bool needDenoise = imageLoad(clearRadianceImage, pixel).a == 0.0 && !invalidDepth && (!transmissionLayer || transmissionGuided);
    if (!needDenoise) {
        imageStore(nrdDiffuseRadianceImage, pixel, vec4(0.0));
        imageStore(nrdSpecularRadianceImage, pixel, vec4(0.0));
        imageStore(nrdMotionVectorImage, pixel, vec4(0.0));
        imageStore(nrdNormalRoughnessImage, pixel, vec4(0.0, 1.0, 0.0, 1.0));
        imageStore(nrdLinearDepthImage, pixel, vec4(min(linearDepth, NRD_INF_DEPTH), 0.0, 0.0, 0.0));
        return;
    }

    vec2 nrdMV = guided ? guideMotion.xy : imageLoad(motionVectorImage, pixel).xy;
    if (any(isnan(nrdMV)) || any(isinf(nrdMV))) nrdMV = vec2(0.0);
    imageStore(nrdMotionVectorImage, pixel, vec4(nrdMV, 0.0, 0.0));

    vec4 normalRoughness = guided ? (transmissionLayer ? transmissionGuide : reflectionGuide) : imageLoad(normalRoughnessImage, pixel);
    vec3 normal = normalize(normalRoughness.xyz + vec3(0.0, 1e-6, 0.0));
    float roughness = normalRoughness.w;
    float specHitDist = guided ? guideMotion.w : imageLoad(specularHitDepthImage, pixel).r;

    imageStore(nrdLinearDepthImage, pixel, vec4(linearDepth, 0.0, 0.0, 0.0));
    imageStore(nrdNormalRoughnessImage, pixel, NRD_FrontEnd_PackNormalAndRoughness(normal, roughness,
        imageLoad(diffuseAlbedoMetallicImage, pixel).a > 0.5 ? 1.0 : 0.0));

    vec4 refractionData = imageLoad(refractionRadianceImage, pixel);
    vec3 refractionRadiance = refractionData.a > 0.5 ? max(refractionData.rgb, vec3(0.0)) : vec3(0.0);
    if (transmissionLayer) {
        float d = NRD_FrontEnd_TrimHitDistance(refractionData.a > 0.5 ? guideMotion.w : 0.0, 1e-3);
        imageStore(nrdDiffuseRadianceImage, pixel, vec4(0));
        vec3 factor = reconstructionStoredFactor(imageLoad(transmissionMaterialFactorImage, pixel));
        imageStore(nrdSpecularRadianceImage, pixel, REBLUR_FrontEnd_PackRadianceAndNormHitDist(safeDiv(refractionRadiance, factor),
            REBLUR_FrontEnd_GetNormHitDist(d, linearDepth, hitDistance.value.xyz, roughness), true));
        return;
    }
    if (transmissionGuided) refractionRadiance = vec3(0);
    vec3 diffRadiance = imageLoad(diffuseIndirectRadianceImage, pixel).rgb + imageLoad(directRadianceImage, pixel).rgb;
    float diffHitDist = NRD_FrontEnd_TrimHitDistance(imageLoad(diffuseIndirectRadianceImage, pixel).a, 1e-3);
    vec3 diffAlbedo, specAlbedo;
    reconstructionMaterialFactors(imageLoad(diffuseAlbedoMetallicImage, pixel),
        imageLoad(specularAlbedoImage, pixel).rgb, roughness, refractionData.a != 0.0, diffAlbedo, specAlbedo);
    if (reflectionGuided) {
        diffAlbedo = reconstructionStoredFactor(imageLoad(reflectionMaterialFactorImage, pixel));
        specAlbedo = diffAlbedo;
    }
    vec3 demodDiffuse = safeDiv(diffRadiance, diffAlbedo);
    float normDiffHitDist = REBLUR_FrontEnd_GetNormHitDist(diffHitDist, linearDepth, hitDistance.value.xyz, 1.0);
    imageStore(nrdDiffuseRadianceImage, pixel,
               REBLUR_FrontEnd_PackRadianceAndNormHitDist(demodDiffuse, normDiffHitDist, true));

    vec4 specularData = imageLoad(specularIndirectRadianceImage, pixel);
    vec3 specRadiance = specularData.rgb + refractionRadiance;
    // A selected transmitted lobe has no reflected hit. Zero must not discard
    // its valid radiance. For two traced lobes use NRD's nearest-path guidance.
    if (!transmissionGuided && refractionData.a > 0.5 && specularData.a > 0.0)
        specHitDist = specHitDist > 0.0 ? min(specHitDist, specularData.a) : specularData.a;
    specHitDist = NRD_FrontEnd_TrimHitDistance(specHitDist, 1e-3);
    vec3 demodSpecular = safeDiv(specRadiance, specAlbedo);
    float normSpecHitDist = REBLUR_FrontEnd_GetNormHitDist(specHitDist, linearDepth, hitDistance.value.xyz, roughness);
    imageStore(nrdSpecularRadianceImage, pixel,
               REBLUR_FrontEnd_PackRadianceAndNormHitDist(demodSpecular, normSpecHitDist, true));
}

#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#include "common/shared.hpp"
#include "util/alpha_mode.glsl"
#include "util/color_space.glsl"
#include "util/ray.glsl"

layout(set = 0, binding = 0) uniform sampler2D textures[];

layout(set = 1, binding = 1) readonly buffer BLASOffsets {
    uint offsets[];
}
blasOffsets;

layout(set = 1, binding = 2) readonly buffer IndexBufferAddr {
    uint64_t addrs[];
}
indexBufferAddrs;

layout(std430, buffer_reference, buffer_reference_align = 8) readonly buffer IndexBuffer {
    uint indices[];
}
indexBuffer;

layout(set=2,binding=0) uniform LayerUniform { WorldUBO layerUBO; };
layout(set=1,binding=7) readonly buffer TextureMappingBuffer { TextureMapping mapping; };
#include "util/vertex.glsl"
#include "util/surface_layers.glsl"

layout(location = 0) rayPayloadInEXT MainRay mainRay;
hitAttributeEXT vec2 attribs;

#include "util/world_material_faces.glsl"
#include "util/layered_texture.glsl"
void main() {
    uint geometry=getGeometryBufferIndex(gl_InstanceCustomIndexEXT,gl_GeometryIndexEXT);
    if(!acceptsWorldMaterialFace(instanceAppearances.values[geometry].materialFlags,
        gl_HitKindEXT==gl_HitKindFrontFacingTriangleEXT,geometry,gl_PrimitiveID,rayDirectImage(mainRay))) {ignoreIntersectionEXT;return;}
    uint i0,i1,i2;PositionVertex p0,p1,p2;MaterialVertex m0,m1,m2;
    loadTriangleCoverage(geometry,gl_PrimitiveID,i0,i1,i2,p0,p1,p2,m0,m1,m2);
    vec3 bary=vec3(1-attribs.x-attribs.y,attribs);
    vec4 tint=(m0.colorLayer*bary.x+m1.colorLayer*bary.y+m2.colorLayer*bary.z)*sourceDrawColour(geometry);
    vec4 colour=evaluateLayeredPlane(mapping.programs[m0.textureID],
        gl_WorldRayOriginEXT+gl_WorldRayDirectionEXT*gl_HitTEXT,layerUBO.cameraPos.xyz,tint,layerUBO.gameTime);
    if(colour.a<=0)ignoreIntersectionEXT;
}

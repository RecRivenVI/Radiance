#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#include "util/alpha_mode.glsl"
#include "util/random.glsl"
#include "util/ray_cone.glsl"
#include "util/ray.glsl"
#include "util/util.glsl"
#include "common/shared.hpp"

layout(set = 0, binding = 0) uniform sampler2D textures[];

layout(set = 1, binding = 1) readonly buffer BLASOffsets {
    uint offsets[];
}
blasOffsets;

layout(set = 1, binding = 2) readonly buffer IndexBufferAddr {
    uint64_t addrs[];
}
indexBufferAddrs;

layout(set = 1, binding = 7) readonly buffer TextureMappingBuffer {
    TextureMapping mapping;
};

layout(set = 2, binding = 0) uniform Uniform {
    WorldUBO ubo;
};

layout(std430, buffer_reference, buffer_reference_align = 8) readonly buffer IndexBuffer {
    uint indices[];
}
indexBuffer;

#include "util/vertex.glsl"
#include "util/surface_layers.glsl"
#include "util/world_material_faces.glsl"
#include "util/water_clip.glsl"

layout(location = 0) rayPayloadInEXT MainRay mainRay;
hitAttributeEXT vec2 attribs;

void main() {
    if (!rayPriorityLayerAllowed(mainRay)) { ignoreIntersectionEXT; return; }
    uint instanceID = gl_InstanceCustomIndexEXT;
    uint geometryID = gl_GeometryIndexEXT;
    uint geometryBufferIndex = getGeometryBufferIndex(instanceID, geometryID);
    if (voxyCovered(geometryBufferIndex, gl_PrimitiveID, vec3(1.0-attribs.x-attribs.y,attribs))) { ignoreIntersectionEXT; return; }
    if (!acceptsWorldMaterialFace(instanceAppearances.values[geometryBufferIndex].materialFlags, gl_HitKindEXT == gl_HitKindFrontFacingTriangleEXT, geometryBufferIndex, gl_PrimitiveID, rayDirectImage(mainRay))) {
        ignoreIntersectionEXT;
        return;
    }
    if (!acceptsUiOwner(instanceAppearances.values[geometryBufferIndex].materialFlags,
            ubo.uiPrimaryOwner, mainRay.stateBits)) {
        ignoreIntersectionEXT;
        return;
    }


    uint i0, i1, i2;
    PositionVertex p0, p1, p2;
    MaterialVertex m0, m1, m2;
    loadTriangleCoverage(geometryBufferIndex, gl_PrimitiveID, i0, i1, i2,
        p0, p1, p2, m0, m1, m2);
    if (!selectMainSurfaceLayer(mainRay,geometryBufferIndex,gl_PrimitiveID,
        vec3(1.0-attribs.x-attribs.y,attribs),gl_HitKindEXT==gl_HitKindFrontFacingTriangleEXT,
        gl_WorldRayOriginEXT,gl_WorldRayDirectionEXT,ubo.seed,gl_HitTEXT,
        mat3(gl_ObjectToWorldEXT),p0,p1,p2,m0,m1,m2)) { ignoreIntersectionEXT; return; }


    vec3 baryCoords = vec3(1.0 - (attribs.x + attribs.y), attribs.x, attribs.y);
    uint packedData = m0.packedData;
    uint textureID = m0.textureID;
    uint alphaMode = getAlphaMode(packedData);

    vec4 colorLayer = hasColorLayer(packedData) ?
                          baryCoords.x * m0.colorLayer + baryCoords.y * m1.colorLayer +
                              baryCoords.z * m2.colorLayer :
                          vec4(1.0);
    float texelAlpha = 1.0;
    vec2 uv = vec2(0.0);
    float lod = 0.0;
    if (hasTexture(packedData)) {
        uv = materialTextureUv(m0, baryCoords.x * m0.textureUV + baryCoords.y * m1.textureUV + baryCoords.z * m2.textureUV);

        float coneRadiusWorld = mainRay.coneWidth + gl_HitTEXT * mainRay.coneSpread;
        vec3 dposdu, dposdv;
        computedposduDv(p0.pos, p1.pos, p2.pos, m0.textureUV, m1.textureUV, m2.textureUV, dposdu, dposdv);
        lod = lodWithObjectCone(textures[nonuniformEXT(textureID)], coneRadiusWorld, mat3(gl_ObjectToWorldEXT),
            p0.pos, p1.pos, p2.pos, m0.textureUV, m1.textureUV, m2.textureUV);

        texelAlpha = sampleMaterialTexture(m0, textures[nonuniformEXT(textureID)], uv, lod, false).a;
    }

    bool coverageBlendCandidate = !materialIsWater(m0);
    if (hasTexture(packedData)) {
        int flagTextureID = mapping.entries[textureID].flag;
        if (flagTextureID >= 0) {
            ivec4 flags = ivec4(round(sampleTexture(textures[nonuniformEXT(flagTextureID)], uv, ceil(lod), false) * 255.0));
            coverageBlendCandidate = (flags.r & 0x1) == 0;
            if ((flags.r & 0x1) != 0 && excludedWaterPosition(gl_WorldRayOriginEXT + gl_WorldRayDirectionEXT * gl_HitTEXT)) {
                ignoreIntersectionEXT;
                return;
            }
        }
    }

    float alpha = resolveSourceAlpha(texelAlpha, hasColorLayerMix(packedData) ? 1.0 : colorLayer.a,
        sourceDrawColour(geometryBufferIndex).a, alphaMode, getSourceAlphaRule(packedData));
    if (rayPrioritySelection(mainRay)) {
        if (alpha <= 0.001) ignoreIntersectionEXT;
        return;
    }
    if (isCoverageAlphaMode(alphaMode)) {
        if (alpha <= 0.0 || (alpha < 1.0 && !(RADIANCE_COVERAGE_CAPTURE != 0 && coverageBlendCandidate && rayCoverageCapture(mainRay)) && rand(mainRay.seed) >= alpha)) {
            ignoreIntersectionEXT;
        }
        return;
    }
    if (isAdditiveAlphaMode(alphaMode)) {
        // Vanilla additive layers are routed through transparent_only. If a custom layer
        // reaches the default group, it must not become an opaque or refractive blocker.
        ignoreIntersectionEXT;
        return;
    }
    if (alpha < 0.05) {
        ignoreIntersectionEXT;
        return;
    }


}

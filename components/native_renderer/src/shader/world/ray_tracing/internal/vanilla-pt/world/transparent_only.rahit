#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#include "common/shared.hpp"
#include "util/alpha_mode.glsl"
#include "util/color_space.glsl"
#include "util/ray.glsl"

layout(set = 0, binding = 0) uniform sampler2D textures[];

layout(set = 1, binding = 1) readonly buffer BLASOffsets {
    uint offsets[];
}
blasOffsets;

layout(set = 1, binding = 2) readonly buffer IndexBufferAddr {
    uint64_t addrs[];
}
indexBufferAddrs;

layout(std430, buffer_reference, buffer_reference_align = 8) readonly buffer IndexBuffer {
    uint indices[];
}
indexBuffer;

layout(set=2,binding=0) uniform LayerUniform { WorldUBO layerUBO; };
#include "util/vertex.glsl"
#include "util/surface_layers.glsl"

layout(location = 0) rayPayloadInEXT MainRay mainRay;
hitAttributeEXT vec2 attribs;

#include "util/world_material_faces.glsl"
void main() {
    if (!acceptsWorldMaterialFace(instanceAppearances.values[getGeometryBufferIndex(gl_InstanceCustomIndexEXT, gl_GeometryIndexEXT)].materialFlags, gl_HitKindEXT == gl_HitKindFrontFacingTriangleEXT, getGeometryBufferIndex(gl_InstanceCustomIndexEXT, gl_GeometryIndexEXT), gl_PrimitiveID, rayDirectImage(mainRay))) {
        ignoreIntersectionEXT;
        return;
    }

    uint geometryBufferIndex = getGeometryBufferIndex(gl_InstanceCustomIndexEXT, gl_GeometryIndexEXT);
    if (voxyCovered(geometryBufferIndex, gl_PrimitiveID, vec3(1.0-attribs.x-attribs.y,attribs))) { ignoreIntersectionEXT; return; }
    uint i0, i1, i2;
    PositionVertex p0, p1, p2;
    MaterialVertex m0, m1, m2;
    loadTriangleCoverage(geometryBufferIndex, gl_PrimitiveID, i0, i1, i2,
        p0, p1, p2, m0, m1, m2);
    if (!selectMainSurfaceLayer(mainRay,geometryBufferIndex,gl_PrimitiveID,
        vec3(1.0-attribs.x-attribs.y,attribs),gl_HitKindEXT==gl_HitKindFrontFacingTriangleEXT,
        gl_WorldRayOriginEXT,gl_WorldRayDirectionEXT,layerUBO.seed,gl_HitTEXT,
        mat3(gl_ObjectToWorldEXT),p0,p1,p2,m0,m1,m2)) { ignoreIntersectionEXT; return; }


    vec3 bary = vec3(1.0 - attribs.x - attribs.y, attribs.x, attribs.y);
    vec4 colorLayer = hasColorLayer(m0.packedData) ?
                          bary.x * m0.colorLayer + bary.y * m1.colorLayer + bary.z * m2.colorLayer :
                          vec4(1.0);
    float texelAlpha = 1.0;
    if (hasTexture(m0.packedData)) {
        vec2 uv = materialTextureUv(m0, bary.x * m0.textureUV + bary.y * m1.textureUV + bary.z * m2.textureUV);
        texelAlpha = sampleMaterialTexture(m0, textures[nonuniformEXT(m0.textureID)], uv, 0.0, false).a;
    }
    float alpha = resolveSourceAlpha(texelAlpha, hasColorLayerMix(m0.packedData) ? 1.0 : colorLayer.a,
        sourceDrawColour(geometryBufferIndex).a, getAlphaMode(m0.packedData), getSourceAlphaRule(m0.packedData));
    if (alpha <= 0.0) { ignoreIntersectionEXT; }
}
